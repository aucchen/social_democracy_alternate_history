[? if uspd_exists : {!<span class="tooltip-text" title="Independent Social Democratic Party. Split from the SPD over the war; torn between the councils and parliament.">USPD</span>!}: [+ uspd_relation : relationship +][? if parliament_name : , [+ uspd_seats +] seats ?] ?]

[? if kapd_exists : {!<span class="tooltip-text" title="Communist Workers' Party. The ultra-left that left or was driven out of the KPD.">KAPD</span>!}: [+ kapd_relation : relationship +] ?]

