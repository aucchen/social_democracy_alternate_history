title: Status
new-page: true
is-special: true

# The sidebar ("the party files"). Each section is one tab.
# Rows are written as a label span (k) and a value span (v), so the page can
# lay them out as a ledger. game.js adds the graphics through these hooks:
#   data-bar="quality"     a 0-100 meter under the row (data-fid: faction colour)
#   data-lock="quality"    colours a party-line lock (0 open, 1 against, 2 forbidden)
#   data-fq="quality"      a faction colour dot for the faction id held in that quality
#   data-fid="faction id"  a faction colour dot for a fixed faction
#   data-ui="name"         a block drawn by game.js (map, charts, rosters)
# Qualities from the second design pass (news, congress, ECCI, districts,
# comrades) are only read by game.js, which copes when they are not set.

= The Party

{!<span class="k">!}Party{!</span><span class="v v-strong">!}[+ party_name +]{!</span>!}

{!<span class="k">!}Funds{!</span><span class="v" data-pips="resources">!}[+ resources +]{!</span>!}

{!<span class="k">!}Members{!</span><span class="v">!}[+ members_display +] thousand{!</span>!}

{!<span class="k">!}Unity{!</span><span class="v" data-bar="unity">!}[+ unity : level +]{!</span>!}

= The Party Line

{!<span class="k">!}Zentrale{!</span><span class="v v-strong" data-fq="leading_faction">!}[+ leading_faction_name +]{!</span>!}

[? if junior_faction : {!<span class="k">!}Junior partner{!</span><span class="v" data-fq="junior_faction">!}[+ junior_faction_name +]{!</span>!} ?]

{!<span class="k">!}Elections{!</span><span class="v" data-lock="lock_elections">!}[+ lock_elections : lock +]{!</span>!}

{!<span class="k">!}United front{!</span><span class="v" data-lock="lock_united_front">!}[+ lock_united_front : lock +]{!</span>!}

{!<span class="k">!}Union work{!</span><span class="v" data-lock="lock_union_work">!}[+ lock_union_work : lock +]{!</span>!}

{!<span class="k">!}Councils and occupations{!</span><span class="v" data-lock="lock_councils">!}[+ lock_councils : lock +]{!</span>!}

{!<span class="k">!}Armed uprising{!</span><span class="v" data-lock="lock_uprising">!}[+ lock_uprising : lock +]{!</span>!}

{!<span class="k">!}Moscow's orders{!</span><span class="v" data-lock="lock_moscow_orders">!}[+ lock_moscow_orders : lock +]{!</span>!}


@factions

= Factions

{!<div class="ui-block" data-ui="faction-stack"></div>!}

[? if luxemburgist_gone = 0 : {!<span class="k" data-fid="luxemburgist"><span class="tooltip-text" title="Luxemburg, Jogiches, Levi, Zetkin. A mass party, democracy inside the party, independence from Moscow.">Spartacists</span></span><span class="v" data-bar="luxemburgist_strength" data-bar-fid="luxemburgist">!}[+ luxemburgist_strength : strength +], [+ luxemburgist_satisfaction : satisfaction +]{!</span>!} ?]

[? if offensive_gone = 0 : {!<span class="k" data-fid="offensive"><span class="tooltip-text" title="Later led by Ruth Fischer and Arkadi Maslow. Armed action soon: the theory of the offensive.">Left</span></span><span class="v" data-bar="offensive_strength" data-bar-fid="offensive">!}[+ offensive_strength : strength +], [+ offensive_satisfaction : satisfaction +]{!</span>!} ?]

[? if unionist_gone = 0 : {!<span class="k" data-fid="unionist"><span class="tooltip-text" title="Later led by Heinrich Brandler and August Thalheimer. Union work and the united front with the SPD and USPD.">Right</span></span><span class="v" data-bar="unionist_strength" data-bar-fid="unionist">!}[+ unionist_strength : strength +], [+ unionist_satisfaction : satisfaction +]{!</span>!} ?]

[? if ultraleft_gone = 0 : {!<span class="k" data-fid="ultraleft"><span class="tooltip-text" title="The Bremen and Hamburg radicals, later the KAPD. Boycott parliament and the unions: councils only.">Left Radicals</span></span><span class="v" data-bar="ultraleft_strength" data-bar-fid="ultraleft">!}[+ ultraleft_strength : strength +], [+ ultraleft_satisfaction : satisfaction +]{!</span>!} ?]

[? if luxemburgist_gone : {!<span class="k k-gone" data-fid="luxemburgist">Spartacists</span><span class="v v-gone">left the party</span>!} ?]

[? if offensive_gone : {!<span class="k k-gone" data-fid="offensive">Left</span><span class="v v-gone">left the party</span>!} ?]

[? if unionist_gone : {!<span class="k k-gone" data-fid="unionist">Right</span><span class="v v-gone">left the party</span>!} ?]

[? if ultraleft_gone : {!<span class="k k-gone" data-fid="ultraleft">Left Radicals</span><span class="v v-gone">left the party</span>!} ?]


