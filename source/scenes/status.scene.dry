[? if dvp_exists : {!<span class="tooltip-text" title="German People's Party. National liberals and heavy industry; Stresemann's party.">DVP</span>!}: [+ dvp_relation : relationship +][? if parliament_name : , [+ dvp_seats +] seats ?] ?]

