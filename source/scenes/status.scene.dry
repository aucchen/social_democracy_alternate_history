@parties

= Parties

{!<div class="ui-block" data-ui="hemicycle"></div>!}

= Relations

[? if spd_exists : {!<span class="k"><i class="pdot p-spd"></i><span class="tooltip-text" title="Majority Social Democratic Party. The party of Ebert, Scheidemann and Noske.">SPD</span></span><span class="v" data-bar="spd_relation" data-bar-party="spd">!}[+ spd_relation : relationship +][? if parliament_name : , [+ spd_seats +] seats ?]{!</span>!} ?]

[? if uspd_exists : {!<span class="k"><i class="pdot p-uspd"></i><span class="tooltip-text" title="Independent Social Democratic Party. Split from the SPD over the war; torn between the councils and parliament.">USPD</span></span><span class="v" data-bar="uspd_relation" data-bar-party="uspd">!}[+ uspd_relation : relationship +][? if parliament_name : , [+ uspd_seats +] seats ?]{!</span>!} ?]

[? if kapd_exists : {!<span class="k"><i class="pdot p-kapd"></i><span class="tooltip-text" title="Communist Workers' Party. The ultra-left that left or was driven out of the KPD.">KAPD</span></span><span class="v" data-bar="kapd_relation" data-bar-party="kapd">!}[+ kapd_relation : relationship +]{!</span>!} ?]

[? if ddp_exists : {!<span class="k"><i class="pdot p-ddp"></i><span class="tooltip-text" title="German Democratic Party. Liberal, middle-class, a pillar of the Weimar coalition.">DDP</span></span><span class="v" data-bar="ddp_relation" data-bar-party="ddp">!}[+ ddp_relation : relationship +][? if parliament_name : , [+ ddp_seats +] seats ?]{!</span>!} ?]

[? if zentrum_exists : {!<span class="k"><i class="pdot p-zentrum"></i><span class="tooltip-text" title="The Catholic Centre Party.">Centre</span></span><span class="v" data-bar="zentrum_relation" data-bar-party="zentrum">!}[+ zentrum_relation : relationship +][? if parliament_name : , [+ zentrum_seats +] seats ?]{!</span>!} ?]

[? if bvp_exists : {!<span class="k"><i class="pdot p-bvp"></i><span class="tooltip-text" title="Bavarian People's Party. Catholic, conservative and Bavarian first.">BVP</span></span><span class="v" data-bar="bvp_relation" data-bar-party="bvp">!}[+ bvp_relation : relationship +][? if bvp_seats > 0 : , [+ bvp_seats +] seats ?]{!</span>!} ?]

[? if dvp_exists : {!<span class="k"><i class="pdot p-dvp"></i><span class="tooltip-text" title="German People's Party. National liberals and heavy industry; Stresemann's party.">DVP</span></span><span class="v" data-bar="dvp_relation" data-bar-party="dvp">!}[+ dvp_relation : relationship +][? if parliament_name : , [+ dvp_seats +] seats ?]{!</span>!} ?]

[? if dnvp_exists : {!<span class="k"><i class="pdot p-dnvp"></i><span class="tooltip-text" title="German National People's Party. Monarchists, landowners and nationalists.">DNVP</span></span><span class="v" data-bar="dnvp_relation" data-bar-party="dnvp">!}[+ dnvp_relation : relationship +][? if parliament_name : , [+ dnvp_seats +] seats ?]{!</span>!} ?]

[? if nsdap_exists : {!<span class="k"><i class="pdot p-nsdap"></i><span class="tooltip-text" title="A small völkisch party in Munich.">!}[+ nsdap_name +]{!</span></span><span class="v" data-bar="nsdap_relation" data-bar-party="nsdap">!}[+ nsdap_relation : relationship +][? if nsdap_seats > 0 : , [+ nsdap_seats +] seats ?]{!</span>!} ?]


@forces

= The State's Forces

{!<span class="k"><span class="tooltip-text" title="The regular army of the Republic, rebuilt as the Reichswehr from March 1919.">!}[+ army_name +]{!</span></span><span class="v" data-bar="army_loyalty" data-bar-tone="ink">!}[+ army_strength_display +]k, loyalty [+ army_loyalty : loyalty +]{!</span>!}

{!<span class="k"><span class="tooltip-text" title="Volunteer units of officers and soldiers, raised by Noske to crush the left.">Freikorps</span></span><span class="v" data-bar="freikorps_loyalty" data-bar-tone="ink">!}[+ freikorps_strength_display +]k, loyalty [+ freikorps_loyalty : loyalty +]{!</span>!}

{!<span class="k"><span class="tooltip-text" title="The state police, and from 1919 the Security Police (Sipo).">Police</span></span><span class="v" data-bar="police_loyalty" data-bar-tone="ink">!}[+ police_strength_display +]k, loyalty [+ police_loyalty : loyalty +]{!</span>!}

[? if civil_guards_strength > 0 : {!<span class="k"><span class="tooltip-text" title="Armed civil guards (Einwohnerwehren) of the propertied classes, strongest in Bavaria.">Civil guards</span></span><span class="v">!}[+ civil_guards_strength_display +]k{!</span>!} ?]

[? if sa_strength > 0 : {!<span class="k"><span class="tooltip-text" title="The storm troopers of the Nazi party.">SA</span></span><span class="v">!}[+ sa_strength_display +]k{!</span>!} ?]

{!<span class="row-note">Bars show loyalty to the Republic.</span>!}

