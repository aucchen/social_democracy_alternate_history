new-page: true
on-arrival: {!
// load the systems library (RG helpers) as soon as the page starts, before
// any save game is loaded; post_event checks again on every turn
if (this.game.scenes.sys_lib) {
    this._runActions(this.game.scenes.sys_lib.onArrival);
}
!}
