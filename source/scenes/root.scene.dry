= Red Germany: 1919–1923

@start_menu_2

- @start: Start game
- @credits: Credits

@start
on-arrival: {!
Q.started = 1;
// time, in months since the start
Q.time = 1;
Q.year = 1919;
Q.month = 1;
Q.month_actions = 0;

Q.difficulty = 0;
Q.hand_size = 3;
Q.discard_disabled = 0;
Q.saves_disabled = 0;

// party funds (the "resources" the cards spend)
Q.resources = 2;
Q.dues = 1;

// ------------------------------------------------------------ factions
// Placeholder starting values: tune these in playtesting.
Q.factions = ['luxemburgist', 'offensive', 'unionist', 'ultraleft'];
// Display names follow the historical currents of the early KPD:
// the Spartacist leadership (Luxemburg, Jogiches, Levi), the Left Radicals
// (Bremen and Hamburg, later the KAPD), the Left (Fischer, Maslow) and
// the Right (Brandler, Thalheimer). The internal ids stay the same.
Q.faction_names = {
    luxemburgist: 'Spartacists',
    offensive: 'Left',
    unionist: 'Right',
    ultraleft: 'Left Radicals'
};
// adjective form, used in "The ... line forbids ..."
Q.faction_adj = {
    luxemburgist: 'Spartacist',
    offensive: 'Left',
    unionist: 'Right',
    ultraleft: 'Left Radical'
};
Q.luxemburgist_satisfaction = 60;
Q.offensive_satisfaction = 50;
Q.unionist_satisfaction = 55;
Q.ultraleft_satisfaction = 45;

// The Zentrale elected at the founding congress is led by Luxemburg's
// circle, while most delegates and districts lean towards the Left Radicals.
Q.leading_faction = 'luxemburgist';
Q.junior_faction = 0;

// actions the party line can open or lock (see post_event)
Q.line_actions = ['elections', 'united_front', 'union_work', 'councils', 'uprising', 'moscow_orders'];

// ------------------------------------------------------------ districts
// members in thousands. Placeholder figures, not historical data.
Q.districts = ['berlin', 'hamburg', 'bremen', 'ruhr', 'saxony', 'thuringia', 'bavaria', 'halle'];
Q.district_names = {
    berlin: 'Berlin-Brandenburg',
    hamburg: 'Hamburg',
    bremen: 'Bremen',
    ruhr: 'Rhineland-Westphalia',
    saxony: 'Saxony',
    thuringia: 'Thuringia',
    bavaria: 'Bavaria',
    halle: 'Halle-Merseburg'
};
Q.district_berlin_faction = 'ultraleft';   Q.district_berlin_members = 3.0;   Q.district_berlin_loyalty = 45;
Q.district_hamburg_faction = 'ultraleft';  Q.district_hamburg_members = 2.0;  Q.district_hamburg_loyalty = 30;
Q.district_bremen_faction = 'ultraleft';   Q.district_bremen_members = 1.5;   Q.district_bremen_loyalty = 25;
Q.district_ruhr_faction = 'ultraleft';     Q.district_ruhr_members = 1.5;     Q.district_ruhr_loyalty = 35;
Q.district_saxony_faction = 'unionist';    Q.district_saxony_members = 1.5;   Q.district_saxony_loyalty = 65;
Q.district_thuringia_faction = 'luxemburgist'; Q.district_thuringia_members = 0.5; Q.district_thuringia_loyalty = 70;
Q.district_bavaria_faction = 'offensive';  Q.district_bavaria_members = 1.0;  Q.district_bavaria_loyalty = 40;
Q.district_halle_faction = 'luxemburgist'; Q.district_halle_members = 0.5;    Q.district_halle_loyalty = 70;
Q.defiance_flag = 0;
Q.split_flag = 0;
Q.spartacist_uprising_done = 0;

// ------------------------------------------------------------ meters
Q.unity = 50;
Q.militancy = 40;
Q.worker_support = 15;
Q.repression = 20;
Q.independence = 65;
Q.world_revolution = 50;
// background values
Q.inflation = 5;
Q.stability = 30;

// ------------------------------------------------------------ dynamic factions
// Options that follow a faction's line add to lean_<faction> (see the
// writer's guide). post_event adds the month's lean to history_<faction>,
// which the historical splits read, and resets the lean.
for (var f of Q.factions) {
    Q['lean_' + f] = 0;
    Q['history_' + f] = 0;
    Q[f + '_gone'] = 0;
}
Q.faction_shift_note = 0;

// ------------------------------------------------------------ parties
// relation 0-100 with the KPD; seats in the current parliament
Q.parties = ['spd', 'uspd', 'kapd', 'ddp', 'zentrum', 'bvp', 'dvp', 'dnvp', 'nsdap'];
Q.party_names = {
    spd: 'SPD', uspd: 'USPD', kapd: 'KAPD', ddp: 'DDP', zentrum: 'Centre',
    bvp: 'BVP', dvp: 'DVP', dnvp: 'DNVP', nsdap: 'NSDAP'
};
Q.spd_relation = 10;      Q.spd_exists = 1;      Q.spd_seats = 0;
Q.uspd_relation = 45;     Q.uspd_exists = 1;     Q.uspd_seats = 0;
Q.kapd_relation = 0;      Q.kapd_exists = 0;     Q.kapd_seats = 0;
Q.ddp_relation = 5;       Q.ddp_exists = 1;      Q.ddp_seats = 0;
Q.zentrum_relation = 5;   Q.zentrum_exists = 1;  Q.zentrum_seats = 0;
Q.bvp_relation = 3;       Q.bvp_exists = 1;      Q.bvp_seats = 0;
Q.dvp_relation = 2;       Q.dvp_exists = 1;      Q.dvp_seats = 0;
Q.dnvp_relation = 0;      Q.dnvp_exists = 1;     Q.dnvp_seats = 0;
Q.nsdap_relation = 0;     Q.nsdap_exists = 1;    Q.nsdap_seats = 0;
Q.kpd_seats = 0;
Q.nsdap_name = 'DAP';     // German Workers' Party; NSDAP from February 1920
Q.parliament_name = 0;    // 'National Assembly', then 'Reichstag'
Q.parliament_size = 0;
for (var p of Q.parties) {
    Q[p + '_in_government'] = 0;
}
Q.spd_in_government = 1;
Q.government_name = 'Council of People\'s Deputies';
Q.chancellor = 'Friedrich Ebert';

// ------------------------------------------------------------ forces
// strength in thousands; loyalty is to the Republic for the state's forces
// and to the Zentrale for our own red guards. Placeholder figures.
Q.forces = ['army', 'freikorps', 'police', 'civil_guards', 'red_guards', 'sa'];
Q.army_strength = 400;        Q.army_loyalty = 40;
Q.freikorps_strength = 40;    Q.freikorps_loyalty = 55;
Q.police_strength = 60;       Q.police_loyalty = 60;
Q.civil_guards_strength = 0;  Q.civil_guards_loyalty = 50;
Q.red_guards_strength = 3;    Q.red_guards_loyalty = 50;
Q.sa_strength = 0;            Q.sa_loyalty = 0;
Q.red_guards_arms = 10;       // 0-100, how well armed our militias are
Q.army_name = 'Army';         // 'Reichswehr' from March 1919

// ------------------------------------------------------------ Moscow
Q.comintern_member = 0;       // the Comintern is founded in March 1919
Q.comintern_rep = 0;          // name of Moscow's envoy, if any
Q.moscow_subsidy = 0;         // funds added each month
Q.soviet_russia_status = 'Civil war';

// ------------------------------------------------------------ crises
// A crisis turns each action into a week instead of a month.
Q.crisis = 0;
Q.week = 0;
Q.crisis_time = 0;
Q.crisis_name = 0;
Q.crisis_goal = 0;
Q.crisis_momentum = 50;

// ------------------------------------------------------------ endings
Q.ending_id = 0;

// ------------------------------------------------------------ story flags
Q.election_boycott = 1;       // decided by the founding congress
Q.luxemburg_alive = 1;
Q.liebknecht_alive = 1;
Q.leaders_risk = 0;
Q.leaders_hidden = 0;

// ------------------------------------------------------------ advisors
Q.advisor_action_timer = 0;
Q.luxemburg_advisor = 1;
Q.liebknecht_advisor = 1;
Q.levi_advisor = 1;

// card timers, decremented each month in post_event
Q.timers = ['dues', 'recruitment', 'rote_fahne', 'organisers', 'factory_councils', 'unions', 'uspd', 'moscow'];
for (var t of Q.timers) {
    Q[t + '_timer'] = 0;
}

// ------------------------------------------------------------ systems (W2)
// districts' militancy, the comrades, Moscow's Executive, the news, the
// ledger: starting values are set by the systems library (sys_lib)
if (typeof RG === 'undefined' && this.game.scenes.sys_lib) {
    this._runActions(this.game.scenes.sys_lib.onArrival);
}
if (typeof RG !== 'undefined') {
    RG.ensureState();
}
!}
new-page: true

> *"Order prevails in Berlin! You foolish lackeys! Your 'order' is built on sand. Tomorrow the revolution will 'rise up again, clashing its weapons,' and to your horror it will proclaim with trumpets blazing: I was, I am, I shall be!"*

 - Rosa Luxemburg, *Order Prevails in Berlin*, January 1919

This is a game of alternate history. It follows the history of the Communist Party of Germany closely at first, but your choices will take Germany, the party and the international movement somewhere else.

- @1919_main: Begin

@1919_main
new-page: true
go-to: post_event

= January 1919

The war is lost, the Kaiser has fled, and Germany is a republic ruled by the councils and the Majority Social Democrats of Friedrich Ebert. Around New Year, the Spartacus League and its allies founded the **Communist Party of Germany**.

The party is small and young. Its Zentrale is led by Rosa Luxemburg, Karl Liebknecht, Leo Jogiches and Paul Levi. But the delegates who founded it are impatient. Against Luxemburg's advice, the congress voted to **boycott** the elections to the National Assembly on 19 January, and most of the big districts, Berlin, Hamburg, Bremen and the Ruhr, follow the ultra-left.

You hold the Zentrale. The districts may not follow.
