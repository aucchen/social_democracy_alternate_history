on-arrival: {!
Q.started = 1;
// time, in months since the start
Q.time = 1;
Q.year = 1919;
Q.month = 1;
Q.month_actions = 0;

Q.difficulty = 0;
Q.hand_size = 3;
Q.discard_disabled = 0;
Q.saves_disabled = 0;

// party funds (the "resources" the cards spend)
Q.resources = 2;
Q.dues = 1;

// ------------------------------------------------------------ factions
// Placeholder starting values: tune these in playtesting.
Q.factions = ['luxemburgist', 'offensive', 'unionist', 'ultraleft'];
Q.faction_names = {
    luxemburgist: 'Luxemburgists',
    offensive: 'Offensive left',
    unionist: 'Unionists',
    ultraleft: 'Ultra-left'
};
Q.luxemburgist_satisfaction = 60;
Q.offensive_satisfaction = 50;
Q.unionist_satisfaction = 55;
Q.ultraleft_satisfaction = 45;

// The Zentrale elected at the founding congress is led by Luxemburg's
// circle, while most delegates and districts lean ultra-left.
Q.leading_faction = 'luxemburgist';
Q.junior_faction = 0;

// actions the party line can open or lock (see post_event)
Q.line_actions = ['elections', 'united_front', 'union_work', 'councils', 'uprising', 'moscow_orders'];

// ------------------------------------------------------------ districts
// members in thousands. Placeholder figures, not historical data.
Q.districts = ['berlin', 'hamburg', 'bremen', 'ruhr', 'saxony', 'thuringia', 'bavaria', 'halle'];
Q.district_names = {
    berlin: 'Berlin-Brandenburg',
    hamburg: 'Hamburg',
    bremen: 'Bremen',
    ruhr: 'Rhineland-Westphalia',
    saxony: 'Saxony',
    thuringia: 'Thuringia',
    bavaria: 'Bavaria',
    halle: 'Halle-Merseburg'
};
Q.district_berlin_faction = 'ultraleft';   Q.district_berlin_members = 3.0;   Q.district_berlin_loyalty = 45;
Q.district_hamburg_faction = 'ultraleft';  Q.district_hamburg_members = 2.0;  Q.district_hamburg_loyalty = 30;
Q.district_bremen_faction = 'ultraleft';   Q.district_bremen_members = 1.5;   Q.district_bremen_loyalty = 25;
Q.district_ruhr_faction = 'ultraleft';     Q.district_ruhr_members = 1.5;     Q.district_ruhr_loyalty = 35;
Q.district_saxony_faction = 'unionist';    Q.district_saxony_members = 1.5;   Q.district_saxony_loyalty = 65;
Q.district_thuringia_faction = 'luxemburgist'; Q.district_thuringia_members = 0.5; Q.district_thuringia_loyalty = 70;
Q.district_bavaria_faction = 'offensive';  Q.district_bavaria_members = 1.0;  Q.district_bavaria_loyalty = 40;
Q.district_halle_faction = 'luxemburgist'; Q.district_halle_members = 0.5;    Q.district_halle_loyalty = 70;
Q.defiance_flag = 0;
Q.split_flag = 0;
Q.spartacist_uprising_done = 0;

// ------------------------------------------------------------ meters
Q.unity = 50;
Q.militancy = 40;
Q.worker_support = 15;
Q.repression = 20;
Q.spd_relation = 10;
Q.uspd_relation = 45;
Q.independence = 65;
Q.world_revolution = 50;
// background values
Q.inflation = 5;
Q.stability = 30;

// ------------------------------------------------------------ story flags
Q.election_boycott = 1;       // decided by the founding congress
Q.luxemburg_alive = 1;
Q.liebknecht_alive = 1;
Q.leaders_risk = 0;
Q.leaders_hidden = 0;

// ------------------------------------------------------------ advisors
Q.advisor_action_timer = 0;
Q.luxemburg_advisor = 1;
Q.liebknecht_advisor = 1;
Q.levi_advisor = 1;

// card timers, decremented each month in post_event
Q.timers = ['dues', 'recruitment', 'rote_fahne', 'organisers', 'factory_councils', 'unions', 'uspd', 'moscow'];
for (var t of Q.timers) {
    Q[t + '_timer'] = 0;
}
!}
new-page: true

> *"Order prevails in Berlin! You foolish lackeys! Your 'order' is built on sand. Tomorrow the revolution will 'rise up again, clashing its weapons,' and to your horror it will proclaim with trumpets blazing: I was, I am, I shall be!"*

 - Rosa Luxemburg, *Order Prevails in Berlin*, January 1919

This is a game of alternate history. It follows the history of the Communist Party of Germany closely at first, but your choices will take Germany, the party and the international movement somewhere else.

This is an early build: only the first months of 1919 are playable so far.

- @1919_main: Begin

@1919_main
new-page: true
go-to: post_event

= January 1919

The war is lost, the Kaiser has fled, and Germany is a republic ruled by the councils and the Majority Social Democrats of Friedrich Ebert. Around New Year, the Spartacus League and its allies founded the **Communist Party of Germany**.

The party is small and young. Its Zentrale is led by Rosa Luxemburg, Karl Liebknecht, Leo Jogiches and Paul Levi. But the delegates who founded it are impatient. Against Luxemburg's advice, the congress voted to **boycott** the elections to the National Assembly on 19 January, and most of the big districts, Berlin, Hamburg, Bremen and the Ruhr, follow the ultra-left.

You hold the Zentrale. The districts may not follow.
