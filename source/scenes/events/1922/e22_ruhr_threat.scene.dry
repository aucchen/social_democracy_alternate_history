}
Q.e22_ruhr_line = 3;
Q.independence -= 4;
Q.worker_support += 1;
Q.luxemburgist_satisfaction -= 6;
Q.ultraleft_satisfaction -= 6;
Q.offensive_satisfaction += 2;
