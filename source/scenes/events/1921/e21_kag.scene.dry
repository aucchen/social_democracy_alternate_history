title: The Communist Working Group
subtitle: Levi's friends found an organisation of their own.
new-page: true
tags: event
view-if: year = 1921 and month >= 9 and crisis = 0 and levi_split = 1 and levi_in_party = 0 and e21_kag_done = 0
