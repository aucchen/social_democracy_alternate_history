on-arrival: {!
// set up the infrastructure
Q.srpd_formed = 1;
Q.parties.push('srpd');

Q.workers_srpd = 6;
Q.workers_spd -= 3;
Q.new_middle_srpd = 6;
Q.old_middle_srpd = 1;
Q.rural_srpd = 1;
Q.unemployed_srpd = 2;
Q.catholics_srpd = 1;

Q.workers_other -= 2;

if (Q.unions_independent) {
    Q.workers_srpd += 8;
}

// update all records
Q.srpd_r = 0;
Q.old_srpd_r = 0;
for (var record of Q.election_records) {
    record['srpd'] = 0;
}
for (var record of Q.party_support_records) {
    record['srpd'] = 0;
}
!}
