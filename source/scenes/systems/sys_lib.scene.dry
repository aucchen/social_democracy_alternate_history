        comrades_in_prison: 0, comrades_free: 0, congress_ready: 0, sys_rival: 0, sys_rival_name: 0, sys_has_rival: 0
    };
    for (var k in def) {
        if (Q[k] === undefined) { Q[k] = copy(def[k]); }
    }
    var start = {lenin: 55, zinoviev: 45, radek: 60, trotsky: 50, bukharin: 50};
    for (var p in start) {
        if (Q['ecci_' + p] === undefined) { Q['ecci_' + p] = start[p]; }
        if (Q['ecci_' + p + '_memory'] === undefined) { Q['ecci_' + p + '_memory'] = 0; }
    }
    if (!Array.isArray(Q.comrades)) { R.buildRoster(); }
    R.districtInit();
    var timers = ['sys_strike', 'sys_guards', 'sys_raids', 'sys_rebuild', 'sys_prisoners', 'sys_directive', 'sys_appeal', 'sys_congress'];
    if (Array.isArray(Q.timers)) {
        timers.forEach(function (t) {
            if (Q.timers.indexOf(t) < 0) { Q.timers.push(t); }
            if (Q[t + '_timer'] === undefined) { Q[t + '_timer'] = 0; }
        });
    }
};
// every pass of post_event, before the party is recomputed
R.everyTurn = function (monthTurned, congressActed) {
    var Q = R.q();
    R.ensureState();
    if (monthTurned) {
        R.districtSync();
        R.districtMonthly();
        R.ecciMonthly();
        R.comradeMonthly();
    }
    R.districtSync();
    R.comradeSync();
    R.ecciCompute();
    if (monthTurned) { R.directiveMonthly(); }
    R.directiveUpdate();
    C.turn(!!congressActed);
    R.ledgerWatch();
};
// at the end of post_event, after the meters are clamped
R.finishTurn = function (monthTurned) {
    R.districtSummary();
    R.eventNews();
    R.newsUpdate(monthTurned);
};

W.RG = R;
!}

