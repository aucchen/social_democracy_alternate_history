        directive_last_time: 0, directive_last_title: 0, directive_punishment: 0, directive_punishment_code: 0,
        directive_rival: 0, directive_rival_name: 0, directive_rival_district_name: 0, directive_goals_met: 0,
        directive_goals_total: 0, directive_count: 0, directives_fulfilled: 0, directives_defied: 0,
        moscow_favour: 50, moscow_backs: 0, moscow_backs_code: 0, moscow_backs_name: 0, ecci_friend: 0, ecci_friend_name: 0,
        ecci_lenin_ill: 0, ecci_friend_favour: 0, ecci_friend_is_author: 0,
        strike_count: 0, strike_districts: 0,
        sys_target: 0, sys_target_name: 0, sys_target_trade: 0, sys_target_striking: 0, sys_target_militancy: 0,
        sys_target_repression: 0, sys_target_faction: 0, sys_target_faction_name: 0, sys_target_ours: 0,
        sys_target_neighbour_name: 0, sys_target_guards: '0', sys_target_members: '0', sys_any_loss: 0, sys_last_arrest: 0, sys_last_arrest_name: 0, sys_outcome: 0,
        sys_prisoner: 0, sys_prisoner_name: 0, sys_prisoner_role: 0,
        election_scope: 0, election_name: 0, election_size: 0, election_kpd_share: 0, election_kpd_share_display: '0.0',
        election_kpd_seats: 0, election_kpd_gain: 0, election_left_seats: 0, election_left_majority: 0,
